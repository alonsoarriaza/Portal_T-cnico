# ===================================================
# COANDA PORTAL TÉCNICO — VARIABLES DE ENTORNO
# ===================================================

# Configuración del Servidor Backend
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portal_coanda
DB_USERNAME=postgres
DB_PASSWORD=tu_contrasena_bbdd

# Seguridad & Autenticación JWT (Clave HMAC-SHA256 mínima 256 bits)
JWT_SECRET=tu_clave_secreta_jwt_minimo_256_bits_aqui
JWT_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=86400000

# Administrador Inicial del Sistema
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=tu_contrasena_admin_segura
INITIAL_ADMIN_EMAIL=admin@coanda.es

# Almacenamiento Documental
STORAGE_PATH=./storage

# Configuración de CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_BASE_URL=/api
